# ============================================================================
#  Not in the repository: large, downloaded, machine-specific or runtime things.
#  What is tracked is the configuration template, the scripts and the docs.
# ============================================================================

# Model files (GGUFs, often tens of GB) — restore with 'llm add'
#  Including the .llm-model.json provenance sidecars. They are the only thing in
#  here that cannot simply be downloaded again - repo, quant, revision SHA and
#  checksums, which 'llm meta backfill' can rebuild only partly and not at all
#  once the Hugging Face cache has been cleaned. They stay out anyway, for the
#  same reason config/llama-swap.yaml does: they are THIS machine's model list,
#  not part of the tool. Back them up with the rest of your configuration -
#  'llm meta' prints what they contain. (If you do want them in your own fork,
#  git will not descend into an ignored directory, so a negation needs
#  'models/*' + '!models/*/' + 'models/*/*' rather than 'models/'.)
models/

# Python environments — recreate with 'llm setup'
venv/
venv-api/
venv-webui/

# Open WebUI runtime data (database, chats, possibly API keys) — do NOT share
openwebui-data/
openwebui-data.bak-*

# Prebuilt binaries (release downloads, not source)
bin/llama-swap
bin/llama-swap-*

# The inference engines are not shipped: 'llm update llama' / 'llm update whisper'
# fetch and build them, or put a symlink here pointing at your own clone.
/llama.cpp
/whisper.cpp

# Vulkan test fixtures, generated by tests/fixtures/mk-vulkan.py. The test
# harness writes them into a temporary directory; these patterns only matter if
# you run the generator by hand. Unlike the rocm-smi ones they are NOT committed:
# the sysfs half is a tree of ~200 two-byte files per case, which is noise rather
# than a readable reference.
tests/fixtures/vulkaninfo-*.sh
tests/fixtures/sysfs-*/

# Caches and compiled files
__pycache__/
*.pyc
.cache/
*.log

# Key for write access to the registry API (machine-specific)
config/api-token
config/api-key
config/api-key.env

# Live configuration: rendered from config/llama-swap.example.yaml by 'llm init',
# contains absolute paths of this machine.
config/llama-swap.yaml

# Lock file for concurrent configuration changes (runtime)
config/.llama-swap.lock

# Written by 'llm gpu sync' — belongs to this machine
config/hardware.env
config/comfyui.env

# Update cache, rollback state, build and smoke logs (runtime)
.update-cache
.update-state
.venv-freeze-*.txt
.smoke.log
.build-*.log

# npm leftovers, in case someone builds the pi extension here
node_modules/

# Local editor/agent settings, and any agent worktree underneath. The whole
# directory, not just settings.local.json: an agent worktree is a second
# checkout of this repository WITH its own config/api-token in it, and only that
# nested checkout's own .gitignore keeps the token out of a 'git add -A' here.
.claude/
